# Browser-visible Supabase project URL and publishable/anon key only.
# No secret or service_role key may use the VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Keep disabled until the trusted Supabase delete-account function is deployed and verified.
VITE_ACCOUNT_DELETION_ENABLED=false
