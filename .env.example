# Browser-visible Supabase project URL and publishable/anon key only.
# No secret or service_role key may use the VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional comma-separated HTTPS origins permitted for versioned game iframe artifacts.
# Leave empty while the isolated plugin runtime/origin is not deployed.
VITE_PLAYORA_GAME_ARTIFACT_ORIGINS=

# Keep disabled until the trusted Supabase delete-account function is deployed and verified.
VITE_ACCOUNT_DELETION_ENABLED=false

# Keep support submissions disabled until the support_reports migration is applied and verified.
VITE_SUPPORT_REPORTS_ENABLED=false
